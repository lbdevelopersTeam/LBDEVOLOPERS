# One Hostinger MariaDB database powers the public website, forms, and admin panel.
# URL-encode special characters in the username/password (for example @ becomes %40).
DATABASE_URL=mysql://database_user:database_password@localhost:3306/database_name
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Optional separate DDL account. Leave unset on Hostinger to use DATABASE_URL.
DATABASE_MIGRATION_URL=

# Required for the first seed only. Remove ADMIN_INITIAL_PASSWORD after setup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
ADMIN_DISPLAY_NAME=LB Super Admin

NODE_ENV=production
PORT=3000
SERVE_STATIC=true
PUBLIC_SITE_URL=https://lbcodebase.com
PUBLIC_CONTACT_EMAIL=lbdevelopers.agency@gmail.com
COOKIE_SECURE=true
SESSION_TTL_MS=43200000
IP_HASH_SALT=replace-with-at-least-32-random-characters
TRUST_PROXY=true

# Hostinger Node.js Web Apps have persistent local storage for a single instance.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIRECTORY=public/uploads
VITE_UPLOAD_TIMEOUT_MS=45000

# Optional S3-compatible storage settings.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

BACKUP_DIRECTORY=backups
