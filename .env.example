# Runtime PostgreSQL role (CRUD only; no schema ownership in production)
DATABASE_URL=postgresql://lb_app:change-me@127.0.0.1:5432/lb_developers
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Migration role (DDL privileges). Used only by npm run db:migrate.
DATABASE_MIGRATION_URL=postgresql://lb_migrator:change-me@127.0.0.1:5432/lb_developers

# Required only for first-time setup. The local setup script removes the
# plaintext value after hashing it; later npm run db:setup runs do not need it.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
ADMIN_DISPLAY_NAME=LB Super Admin

PORT=3000
SERVE_STATIC=false
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_CONTACT_EMAIL=lbdevelopers.agency@gmail.com
COOKIE_SECURE=false
SESSION_TTL_MS=43200000
IP_HASH_SALT=replace-with-a-long-random-value
TRUST_PROXY=false

# Local storage works on persistent Node hosts. Use S3-compatible storage on
# serverless or horizontally scaled deployments where the local disk is ephemeral.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIRECTORY=public/uploads
# Optional frontend build-time upload timeout in milliseconds.
VITE_UPLOAD_TIMEOUT_MS=45000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

BACKUP_DIRECTORY=backups

# MySQL 8.0.34+ powers the independent /api/v3 contract. Use separate runtime
# and migration accounts in production; never commit their real passwords.
MYSQL_DATABASE_URL=mysql://lb_v3_app:change-me@127.0.0.1:3306/lb_developers_v3
MYSQL_MIGRATION_URL=mysql://lb_v3_migrator:change-me@127.0.0.1:3306/lb_developers_v3
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_POOL_MAX=10
MYSQL_ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
API_CURSOR_SECRET=replace-with-at-least-32-random-characters
API_V3_REQUIRED=false
API_ACCESS_LOG=false
