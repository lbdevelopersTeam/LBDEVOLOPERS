{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "node scripts/hostinger-postinstall.mjs",
    "start": "node server.js",
    "dev": "tsx server.ts",
    "prebuild": "npm run clean",
    "build": "vite build --configLoader runner --outDir dist",
    "build:node": "vite build --configLoader runner --outDir dist/public && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview --configLoader runner --outDir dist",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "test:deployment": "node --test scripts/hostinger-deployment.test.mjs",
    "test:watch": "vitest --config vitest.config.ts --configLoader runner",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:seed:curated-projects": "tsx server/db/seed-curated-projects.ts",
    "db:attach-project-mockups": "tsx server/db/attach-project-mockups.ts",
    "db:verify:curated-projects": "tsx server/db/verify-curated-projects.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:verify": "tsx server/db/verify.ts",
    "hostinger:deploy": "npm run build",
    "verify:performance": "node scripts/check-performance-budget.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.13.25",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.6.2",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "mysql2": "^3.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "vite": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "ip-address": "^10.7.1",
    "source-map-js": "^1.2.2",
    "tsx": {
      "esbuild": "^0.28.1"
    }
  }
}
